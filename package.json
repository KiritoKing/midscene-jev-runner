{
  "name": "midscene-jev-runner",
  "version": "0.1.0",
  "description": "Community-maintained JEV runner integration for Midscene Test",
  "homepage": "https://github.com/KiritoKing/midscene-jev-runner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KiritoKing/midscene-jev-runner.git"
  },
  "bugs": {
    "url": "https://github.com/KiritoKing/midscene-jev-runner/issues"
  },
  "type": "module",
  "main": "./dist/lib/index.cjs",
  "module": "./dist/es/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/es/index.js",
      "require": "./dist/lib/index.cjs"
    }
  },
  "files": [
    "dist",
    "example",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "scripts": {
    "build": "rslib build",
    "lint": "biome check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "keywords": [
    "midscene",
    "jev",
    "playwright",
    "runner",
    "testing",
    "browser-automation"
  ],
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "pnpm": ">=9.3.0"
  },
  "packageManager": "pnpm@9.3.0",
  "peerDependencies": {
    "@midscene/test": "^1.13.0",
    "playwright": ">=1.45.0 <2"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@microsoft/api-extractor": "^7.52.0",
    "@midscene/test": "1.13.0",
    "@rslib/core": "^0.18.3",
    "@types/node": "^20.19.0",
    "playwright": "^1.45.0",
    "typescript": "^5.8.3",
    "vitest": "3.0.5"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
